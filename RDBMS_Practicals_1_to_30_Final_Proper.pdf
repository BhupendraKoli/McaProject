q q 1 0 0 1 78 741.8898 cm 0 0 0 rg BT 22 TL/F2 18 Tf 1 0 0 1 0 4 Tm (PL/SQL Practical No. 14 - Exception Handling)Tj T* ET Q q 1 0 0 1 78 89.48976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 616.8 Tm (QUESTION:)Tj T* T* (Write a program to illustrate:)Tj T* (1. User-defined exceptions)Tj T* (2. Built-in exceptions)Tj T* (3. Raise application error exceptions)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 1: BUILT-IN EXCEPTION \(ZERO_DIVIDE\))Tj T* (------------------------------------------------------------)Tj T* T* (SET SERVEROUTPUT ON;)Tj T* T* (DECLARE)Tj T* (    num1 NUMBER := 10;)Tj T* (    num2 NUMBER := 0;)Tj T* (    result NUMBER;)Tj T* (BEGIN)Tj T* (    result := num1 / num2;)Tj T* (    DBMS_OUTPUT.PUT_LINE\('Result: ' || result\);)Tj T* T* (EXCEPTION)Tj T* (    WHEN ZERO_DIVIDE THEN)Tj T* (        DBMS_OUTPUT.PUT_LINE\('Error: Cannot divide by zero.'\);)Tj T* (END;)Tj T* (/)Tj T* T* (EXPECTED OUTPUT:)Tj T* (Error: Cannot divide by zero.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 2: USER-DEFINED EXCEPTION)Tj T* (------------------------------------------------------------)Tj T* T* (DECLARE)Tj T* (    age NUMBER := 15;)Tj T* (    invalid_age EXCEPTION;)Tj T* (BEGIN)Tj T* (    IF age < 18 THEN)Tj T* (        RAISE invalid_age;)Tj T* (    END IF;)Tj T* T* (    DBMS_OUTPUT.PUT_LINE\('Valid Age'\);)Tj T* T* (EXCEPTION)Tj T* (    WHEN invalid_age THEN)Tj T* (        DBMS_OUTPUT.PUT_LINE\('Error: Age must be 18 or above.'\);)Tj T* (END;)Tj T* (/)Tj T* T* (EXPECTED OUTPUT:)Tj T* (Error: Age must be 18 or above.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 3: RAISE_APPLICATION_ERROR EXCEPTION)Tj T* (------------------------------------------------------------)Tj T* T* (DECLARE)Tj T* (    salary NUMBER := 2000;)Tj T* (BEGIN)Tj T* (    IF salary < 5000 THEN)Tj T* (        RAISE_APPLICATION_ERROR\(-20001, 'Salary too low.'\);)Tj T* (    END IF;)Tj T* T* (    DBMS_OUTPUT.PUT_LINE\('Salary is acceptable.'\);)Tj T* T* (EXCEPTION)Tj T* (    WHEN OTHERS THEN)Tj T* (        DBMS_OUTPUT.PUT_LINE\(SQLERRM\);)Tj T* (END;)Tj T* (/)Tj T* ET Q q 1 0 0 1 78 80.68976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 .8 Tm (EXPECTED OUTPUT:)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F107dd95e8-eb42-49d5-8360-ef595743bf17 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
endstream
