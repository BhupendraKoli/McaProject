q q 1 0 0 1 78 719.8898 cm 0 0 0 rg BT -.125487 Tw 22 TL/F2 18 Tf 1 0 0 1 0 26 Tm (PL/SQL Practical No. 10 - Procedure for Percentage)Tj T* 0 Tw (Range)Tj T* ET Q q 1 0 0 1 78 85.08976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 599.2 Tm (QUESTION:)Tj T* T* (Write a PL/SQL procedure to find the number of students ranging from )Tj T* (100-70%, 69-60%, 59-50% & below 49% in each course from the )Tj T* (STUDENT_COURSE table given by the procedure as parameter.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 1: CREATE TABLE)Tj T* (------------------------------------------------------------)Tj T* T* (CREATE TABLE STUDENT_COURSE \()Tj T* (    Student_id NUMBER PRIMARY KEY,)Tj T* (    Student_name VARCHAR2\(50\),)Tj T* (    Course VARCHAR2\(50\),)Tj T* (    Percentage NUMBER)Tj T* (\);)Tj T* T* (OUTPUT:)Tj T* (Table Created.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 2: INSERT SAMPLE DATA)Tj T* (------------------------------------------------------------)Tj T* T* (INSERT INTO STUDENT_COURSE VALUES \(1,'Om','MCA',85\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(2,'Rahul','MCA',72\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(3,'Sneha','MCA',65\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(4,'Amit','MCA',55\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(5,'Neha','MCA',45\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(6,'Karan','BCA',78\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(7,'Pooja','BCA',62\);)Tj T* (INSERT INTO STUDENT_COURSE VALUES \(8,'Riya','BCA',48\);)Tj T* T* (COMMIT;)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 3: CREATE PROCEDURE)Tj T* (------------------------------------------------------------)Tj T* T* (SET SERVEROUTPUT ON;)Tj T* T* (CREATE OR REPLACE PROCEDURE Student_Percentage_Report\(p_course IN VARCHAR2\))Tj T* (IS)Tj T* (    v_70_100 NUMBER;)Tj T* (    v_60_69  NUMBER;)Tj T* (    v_50_59  NUMBER;)Tj T* (    v_below49 NUMBER;)Tj T* (BEGIN)Tj T* (    SELECT COUNT\(*\) INTO v_70_100)Tj T* (    FROM STUDENT_COURSE)Tj T* (    WHERE Course = p_course AND Percentage BETWEEN 70 AND 100;)Tj T* T* (    SELECT COUNT\(*\) INTO v_60_69)Tj T* (    FROM STUDENT_COURSE)Tj T* (    WHERE Course = p_course AND Percentage BETWEEN 60 AND 69;)Tj T* T* (    SELECT COUNT\(*\) INTO v_50_59)Tj T* (    FROM STUDENT_COURSE)Tj T* (    WHERE Course = p_course AND Percentage BETWEEN 50 AND 59;)Tj T* T* (    SELECT COUNT\(*\) INTO v_below49)Tj T* (    FROM STUDENT_COURSE)Tj T* (    WHERE Course = p_course AND Percentage < 49;)Tj T* T* (    DBMS_OUTPUT.PUT_LINE\('Course: ' || p_course\);)Tj T* (    DBMS_OUTPUT.PUT_LINE\('70-100% Students: ' || v_70_100\);)Tj T* (    DBMS_OUTPUT.PUT_LINE\('60-69% Students: ' || v_60_69\);)Tj T* (    DBMS_OUTPUT.PUT_LINE\('50-59% Students: ' || v_50_59\);)Tj T* (    DBMS_OUTPUT.PUT_LINE\('Below 49% Students: ' || v_below49\);)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F1bd295627-4f59-4b22-bbf2-56aee72e503a 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
endstream
