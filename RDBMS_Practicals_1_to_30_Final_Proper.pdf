q q 1 0 0 1 78 741.8898 cm 0 0 0 rg BT 22 TL/F2 18 Tf 1 0 0 1 0 4 Tm (PL/SQL Practical Examination)Tj T* ET Q q 1 0 0 1 78 617.4898 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 88.8 Tm (Question:)Tj T* (Write a PL/SQL code to create an employee database with the tables )Tj T* (and fields specified as below.)Tj T* T* (Employee [Emp_no, Employee_name, Street, City])Tj T* T* (Works [Emp_no, Company_name, Joining_date, Designation, Salary])Tj T* T* (Company [Emp_no, City])Tj T* T* (Manages [Emp_no, Manager_name, Mang_no])Tj T* ET Q q 1 0 0 1 78 85.48976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 502.4 Tm (-----------------------------------------------)Tj T* (STEP 1: CREATE TABLES)Tj T* (-----------------------------------------------)Tj T* T* (CREATE TABLE Employee \()Tj T* (    Emp_no NUMBER PRIMARY KEY,)Tj T* (    Employee_name VARCHAR2\(50\),)Tj T* (    Street VARCHAR2\(50\),)Tj T* (    City VARCHAR2\(50\))Tj T* (\);)Tj T* T* (CREATE TABLE Works \()Tj T* (    Emp_no NUMBER,)Tj T* (    Company_name VARCHAR2\(50\),)Tj T* (    Joining_date DATE,)Tj T* (    Designation VARCHAR2\(50\),)Tj T* (    Salary NUMBER\(8,2\),)Tj T* (    PRIMARY KEY \(Emp_no\),)Tj T* (    FOREIGN KEY \(Emp_no\) REFERENCES Employee\(Emp_no\))Tj T* (\);)Tj T* T* (CREATE TABLE Company \()Tj T* (    Emp_no NUMBER,)Tj T* (    City VARCHAR2\(50\),)Tj T* (    PRIMARY KEY \(Emp_no\),)Tj T* (    FOREIGN KEY \(Emp_no\) REFERENCES Employee\(Emp_no\))Tj T* (\);)Tj T* T* (CREATE TABLE Manages \()Tj T* (    Emp_no NUMBER,)Tj T* (    Manager_name VARCHAR2\(50\),)Tj T* (    Mang_no NUMBER,)Tj T* (    PRIMARY KEY \(Emp_no\),)Tj T* (    FOREIGN KEY \(Emp_no\) REFERENCES Employee\(Emp_no\))Tj T* (\);)Tj T* T* (OUTPUT:)Tj T* (Table Created.)Tj T* T* (-----------------------------------------------)Tj T* (STEP 2: INSERT SAMPLE DATA)Tj T* (-----------------------------------------------)Tj T* T* (INSERT INTO Employee VALUES \(1,'Om','MG Road','Mumbai'\);)Tj T* T* (INSERT INTO Works VALUES \(1,'TCS',)Tj T* (TO_DATE\('01-01-2024','DD-MM-YYYY'\),)Tj T* ('Developer',40000\);)Tj T* T* (INSERT INTO Company VALUES \(1,'Mumbai'\);)Tj T* T* (INSERT INTO Manages VALUES \(1,'Amit',101\);)Tj T* T* (COMMIT;)Tj T* T* (OUTPUT:)Tj T* (1 row inserted.)Tj T* (Commit complete.)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F106d47f44-fc80-4368-ae5d-0d1062cbfa2f 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
