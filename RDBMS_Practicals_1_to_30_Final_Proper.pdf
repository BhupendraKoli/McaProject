q q 1 0 0 1 78 741.8898 cm 0 0 0 rg BT 22 TL/F2 18 Tf 1 0 0 1 0 4 Tm (SQL Practical No. 2 - Hospital Database)Tj T* ET Q q 1 0 0 1 78 89.48976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 616.8 Tm (QUESTION:)Tj T* T* (Consider the following schema for a Hospital Database:)Tj T* T* (DOCTOR \(Did, Dname, DAddress, Qualification\))Tj T* (PATIENTMASTER \(Pcode, Pname, Padd, age, gender, bloodgroup, Pid\))Tj T* (ADMITTEDPATIENT \(Pcode, EntryDate, DischargeDate, WardNo, Disease\))Tj T* T* (Queries:)Tj T* (a\) Find the detail of the doctor who is treating the patient of ward no 3)Tj T* (b\) Find the detail of patient admitted within period 03/03/2020 to 25/05/2020)Tj T* (c\) Find the detail of patient who are suffered from blood cancer)Tj T* (d\) Create view on DOCTOR & PATIENTMASTER tables)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 1: CREATE TABLES)Tj T* (------------------------------------------------------------)Tj T* T* (CREATE TABLE DOCTOR \()Tj T* (    Did NUMBER PRIMARY KEY,)Tj T* (    Dname VARCHAR2\(50\),)Tj T* (    DAddress VARCHAR2\(100\),)Tj T* (    Qualification VARCHAR2\(30\))Tj T* (\);)Tj T* T* (CREATE TABLE PATIENTMASTER \()Tj T* (    Pcode NUMBER PRIMARY KEY,)Tj T* (    Pname VARCHAR2\(50\),)Tj T* (    Padd VARCHAR2\(100\),)Tj T* (    age NUMBER,)Tj T* (    gender CHAR\(1\),)Tj T* (    bloodgroup VARCHAR2\(5\),)Tj T* (    Pid NUMBER,)Tj T* (    FOREIGN KEY \(Pid\) REFERENCES DOCTOR\(Did\))Tj T* (\);)Tj T* T* (CREATE TABLE ADMITTEDPATIENT \()Tj T* (    Pcode NUMBER,)Tj T* (    EntryDate DATE,)Tj T* (    DischargeDate DATE,)Tj T* (    WardNo NUMBER,)Tj T* (    Disease VARCHAR2\(50\),)Tj T* (    FOREIGN KEY \(Pcode\) REFERENCES PATIENTMASTER\(Pcode\))Tj T* (\);)Tj T* T* (OUTPUT:)Tj T* (Table Created.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 2: INSERT SAMPLE DATA)Tj T* (------------------------------------------------------------)Tj T* T* (INSERT INTO DOCTOR VALUES \(1,'Dr. Amit','Mumbai','MBBS'\);)Tj T* (INSERT INTO DOCTOR VALUES \(2,'Dr. Neha','Pune','MD'\);)Tj T* T* (INSERT INTO PATIENTMASTER VALUES \(101,'Rahul','Mumbai',25,'M','A+',1\);)Tj T* (INSERT INTO PATIENTMASTER VALUES \(102,'Sneha','Pune',40,'F','B+',2\);)Tj T* T* (INSERT INTO ADMITTEDPATIENT VALUES)Tj T* (\(101, TO_DATE\('05-03-2020','DD-MM-YYYY'\),)Tj T* ( TO_DATE\('15-03-2020','DD-MM-YYYY'\), 3, 'Fever'\);)Tj T* T* (INSERT INTO ADMITTEDPATIENT VALUES)Tj T* (\(102, TO_DATE\('10-04-2020','DD-MM-YYYY'\),)Tj T* ( TO_DATE\('20-05-2020','DD-MM-YYYY'\), 2, 'Blood Cancer'\);)Tj T* T* (COMMIT;)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 3: QUERIES)Tj T* (------------------------------------------------------------)Tj T* ET Q q 1 0 0 1 78 80.68976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 .8 Tm (a\) Doctor treating patient in ward no 3)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F1ba71d753-f8b3-4118-90e6-8423b79d0f99 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
endstream
