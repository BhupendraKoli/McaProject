q q 1 0 0 1 78 121.4898 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 634.4 Tm (    PROCEDURE Retrieve_Student\(p_id NUMBER\) IS)Tj T* (        v_name STUDENT.Student_name%TYPE;)Tj T* (        v_course STUDENT.Course%TYPE;)Tj T* (        v_marks STUDENT.Marks%TYPE;)Tj T* (    BEGIN)Tj T* (        SELECT Student_name, Course, Marks)Tj T* (        INTO v_name, v_course, v_marks)Tj T* (        FROM STUDENT)Tj T* (        WHERE Student_id = p_id;)Tj T* T* (        DBMS_OUTPUT.PUT_LINE\('Name: ' || v_name\);)Tj T* (        DBMS_OUTPUT.PUT_LINE\('Course: ' || v_course\);)Tj T* (        DBMS_OUTPUT.PUT_LINE\('Marks: ' || v_marks\);)Tj T* (    END;)Tj T* T* (    PROCEDURE Update_Student\()Tj T* (        p_id NUMBER,)Tj T* (        p_name VARCHAR2,)Tj T* (        p_course VARCHAR2,)Tj T* (        p_marks NUMBER\) IS)Tj T* (    BEGIN)Tj T* (        UPDATE STUDENT)Tj T* (        SET Student_name = p_name,)Tj T* (            Course = p_course,)Tj T* (            Marks = p_marks)Tj T* (        WHERE Student_id = p_id;)Tj T* T* (        DBMS_OUTPUT.PUT_LINE\('Student Updated Successfully'\);)Tj T* (    END;)Tj T* T* (    PROCEDURE Delete_Student\(p_id NUMBER\) IS)Tj T* (    BEGIN)Tj T* (        DELETE FROM STUDENT)Tj T* (        WHERE Student_id = p_id;)Tj T* T* (        DBMS_OUTPUT.PUT_LINE\('Student Deleted Successfully'\);)Tj T* (    END;)Tj T* T* (END Student_Pkg;)Tj T* (/)Tj T* T* (OUTPUT:)Tj T* (Package Body Created.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 4: CALL PACKAGE PROCEDURES)Tj T* (------------------------------------------------------------)Tj T* T* (EXEC Student_Pkg.Insert_Student\(1,'Om','MCA',85\);)Tj T* (EXEC Student_Pkg.Retrieve_Student\(1\);)Tj T* (EXEC Student_Pkg.Update_Student\(1,'Omkar','MCA',90\);)Tj T* (EXEC Student_Pkg.Delete_Student\(1\);)Tj T* T* (COMMIT;)Tj T* T* (------------------------------------------------------------)Tj T* (EXPECTED OUTPUT:)Tj T* T* (Student Inserted Successfully)Tj T* (Name: Om)Tj T* (Course: MCA)Tj T* (Marks: 85)Tj T* (Student Updated Successfully)Tj T* (Student Deleted Successfully)Tj T* T* (------------------------------------------------------------)Tj T* (VIVA POINTS:)Tj T* T* (1. Package Specification declares procedures/functions.)Tj T* (2. Package Body defines implementation.)Tj T* (3. Package improves modularity and code reusability.)Tj T* (4. EXEC is used to call stored procedures.)Tj T* (5. %TYPE inherits datatype from table column.)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F16510cfad-547f-4075-a57f-6b52ee33cf18 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
endstream
