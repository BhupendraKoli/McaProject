q q 1 0 0 1 78 719.8898 cm 0 0 0 rg BT 22 TL/F2 18 Tf 1 0 0 1 0 26 Tm (PL/SQL Practical No. 13 - Package Specification)Tj T* (and Body)Tj T* ET Q q 1 0 0 1 78 85.08976 cm 0 0 0 rg BT 8.8 TL/F3 8 Tf 1 0 0 1 36 599.2 Tm (QUESTION:)Tj T* T* (Write a PL/SQL code to create:)Tj T* T* (1. Package Specification)Tj T* (2. Package Body)Tj T* T* (For the insert, retrieve, update, and delete operations on a STUDENT table.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 1: CREATE STUDENT TABLE)Tj T* (------------------------------------------------------------)Tj T* T* (CREATE TABLE STUDENT \()Tj T* (    Student_id NUMBER PRIMARY KEY,)Tj T* (    Student_name VARCHAR2\(50\),)Tj T* (    Course VARCHAR2\(50\),)Tj T* (    Marks NUMBER)Tj T* (\);)Tj T* T* (OUTPUT:)Tj T* (Table Created.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 2: CREATE PACKAGE SPECIFICATION)Tj T* (------------------------------------------------------------)Tj T* T* (CREATE OR REPLACE PACKAGE Student_Pkg AS)Tj T* T* (    PROCEDURE Insert_Student\()Tj T* (        p_id NUMBER,)Tj T* (        p_name VARCHAR2,)Tj T* (        p_course VARCHAR2,)Tj T* (        p_marks NUMBER\);)Tj T* T* (    PROCEDURE Retrieve_Student\(p_id NUMBER\);)Tj T* T* (    PROCEDURE Update_Student\()Tj T* (        p_id NUMBER,)Tj T* (        p_name VARCHAR2,)Tj T* (        p_course VARCHAR2,)Tj T* (        p_marks NUMBER\);)Tj T* T* (    PROCEDURE Delete_Student\(p_id NUMBER\);)Tj T* T* (END Student_Pkg;)Tj T* (/)Tj T* T* (OUTPUT:)Tj T* (Package Created.)Tj T* T* (------------------------------------------------------------)Tj T* (STEP 3: CREATE PACKAGE BODY)Tj T* (------------------------------------------------------------)Tj T* T* (SET SERVEROUTPUT ON;)Tj T* T* (CREATE OR REPLACE PACKAGE BODY Student_Pkg AS)Tj T* T* (    PROCEDURE Insert_Student\()Tj T* (        p_id NUMBER,)Tj T* (        p_name VARCHAR2,)Tj T* (        p_course VARCHAR2,)Tj T* (        p_marks NUMBER\) IS)Tj T* (    BEGIN)Tj T* (        INSERT INTO STUDENT)Tj T* (        VALUES \(p_id, p_name, p_course, p_marks\);)Tj T* (        DBMS_OUTPUT.PUT_LINE\('Student Inserted Successfully'\);)Tj T* (    END;)Tj T* ET Q Q q 0 0 612 792 re W n BT 9.6 TL/F191fa1aef-c33b-4052-9879-06c5aa84559c 8 Tf 1 0 0 1 511.352 777.6 Tm T* ET Q
endstream
